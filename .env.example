# Postgres (Neon works great, or any Postgres)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Square — create a Personal Access Token from the Square Developer Dashboard
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# production | sandbox
SQUARE_ENVIRONMENT=sandbox

# Resend — for low-stock email alerts
RESEND_API_KEY=
# Must be a verified sender in your Resend account
ALERT_EMAIL_FROM=alerts@yourshop.com
ALERT_EMAIL_TO=you@yourshop.com

# App auth — a single shared password for the dashboard
APP_PASSWORD=change-me
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Cron protection — Vercel sends this automatically if configured,
# otherwise set it yourself and pass it as Authorization: Bearer <secret>
CRON_SECRET=generate-a-long-random-string
